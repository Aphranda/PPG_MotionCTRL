//EXT_Excution.sc
function ext_excution(param1)

end


dut_result = 0


function ext_startok(times)
mc.setdo(1,1)
delay(times)
mc.setdo(1,0)
print("======START OK======")
end


function ext_resetok(times)
mc.setdo(2,1)
delay(times)
mc.setdo(2,0)
print("======RESET OK======")
end


function ext_testerror(times)
mc.setdo(3,1)
delay(times)
mc.setdo(3,0)
print("======TEST ERROR======")
end


function ext_duttestok(times)
mc.setdo(4,1)
delay(times)
mc.setdo(4,0)
print("======DUT OK======")
end


function ext_duttestng(times)
mc.setdo(5,1)
delay(times)
mc.setdo(5,0)
print("======DUT NG======")
end


function ext_duttestresult(times)
if dut_result == 0 then
ext_duttestng(times)
end

if dut_result == 1 then
ext_duttestok(times)
end

if dut_result == 2 then
ext_testerror(times)
end
end


function ext_starttest(times)
btnstarttest1 = mc.getdi(9)
delay(times)
btnstarttest2 = mc.getdi(9)
btnstarttestnum = btnstarttest1 + btnstarttest2
testmachine_autocheck = check_auto()
if btnstarttestnum == 0 and testmachine_autocheck == 1 then
if gmodestate == 0 then  
gteststep = 1 
print("==============EXT TEST START===============")
end

if gmodestate == 1 then 
gcalstep = 2 
print("==============EXT CAL START===============")
end

if gmodestate == 2 then 
gpistep = 2 
print("==============EXT CAL START===============")
end
end
end


function ext_startreset(times)
btnstartreset1 = mc.getdi(10)
delay(times)
btnstartreset2 = mc.getdi(10)

btnstartresetnum = btnstartreset1 + btnstartreset2
if btnstartresetnum == 0 then
motion_home()
print("==============EXT HOME===============")
end
end


function ext_stoptest(times)
btnstoptest1 = mc.getdi(11)
delay(times)
btnstoptest2 = mc.getdi(11)

btnstoptestnum = btnstoptest1 + btnstoptest2
if btnstoptestnum == 0 then
if gmodestate == 0 then  
gteststep = 3 
print("==============EXT TEST START===============")
end

if gmodestate == 1 then 
gcalstep = 3 
print("==============EXT CAL START===============")
end

if gmodestate == 2 then 
gpistep = 3 
print("==============EXT CAL START===============")
end
end
end


function ext_modeselect(times)
mode1 = mc.getdi(12)
delay(times)
mode2 = mc.getdi(13)


if mode1 == 0 and mode2 == 1 then
gmodestate = 1
end


if mode1 == 1 and mode2 == 0 then
gmodestate = 2
end


if mode1 == 1 and mode2 == 1 then
gmodestate = 0
end
end


//BTN_Excution.sc


function btn_excution(param1)
if btn_test == 1 then
print(" =CYL= ")
cyl1_encode(1)
delay(1000)
cyl1_encode(0)
delay(1000)
cyl1_encode(1)
delay(1000)
cyl1_encode(0)
delay(1000)
cyl2_encode(1)
delay(1000)
cyl2_encode(0)
end
end



function allbtnispress(times)
btnlstate = mc.getdi(4)	
btnrstate = mc.getdi(5)
count = 0
countmax = times*10
btn_num = btnlstate + btnrstate
testmachine_autocheck = check_auto()

if btn_num == 0  and testmachine_autocheck == 0 then
while count < countmax and count > - countmax do
btnlstate = mc.getdi(4)
btnrstate = mc.getdi(5)
btn_num = btnlstate + btnrstate
if btnlstate + btnrstate == 0 then
count = count + 1
delay(100)
if count == countmax then
print("Pressed")
count = 0
return "Pressed"
end
else
count = count -1
delay(100)
if count == - countmax then
print("Released")
count = 0
return "Released"
end
end
print("COUNTA:",count)
end
end
end


function anybtnispress(times)
btnlstate = mc.getdi(4)
btnrstate = mc.getdi(5)
count = 0
countmax = times*10
btn_num = btnlstate + btnrstate
testmachine_autocheck = check_auto()

if btn_num == 1 and testmachine_autocheck == 0 then
while count < countmax and count > - countmax do
btnlstate = mc.getdi(4)
btnrstate = mc.getdi(5)
btn_num = btnlstate + btnrstate
if btnlstate == 0 or btnrstate == 0 then
count = count + 1
delay(100)
if count == countmax then
print("Pressed")
count = 0
return "Pressed"
end
else
count = count -1
delay(100)
if count == - countmax then
print("Released")
count =  0
return "Released"
end
end
print("COUNTS:",count, btnlstate, btnrstate)
end
end
end


function btn_emerged()
btn_stop = mc.getdi(1)
if btn_stop == 1 then
eth_write(0,"EMERGENCY")
led_redflash()
gsmstep = 5
gteststep = 0
mc.movstop(axis)
mc.runstop()
return 1
end
end


function btn_laser()
btn_laser = mc.getdi(6)
if btn_laser == 1 then
gsmstep = 5
gteststep = 0
rtn = mc.axissts(axis,0)
if rtn ~=0 then
mc.movstop(axis)
end
end
end


function check_auto(param1)
auto_io = mc.getdi(15)
if auto_io == 0 then
return 1
else
return 0
end
end

function check_emerage(param1)
stop_sig = mc.getdi(14)
if stop_sig == 0 then
print("E_STOP")
print("STOP_SIG:",stop_sig)
mc.movstop(axis)
end
end


//State_Machine.sc
gsmsinitflag = 1		
gsmstep = 0			
gsmoldstep = 0
gsmststate = {"IDLE","READY","RUNNING","TESTING","LOCK","EMERGENCY"}

gteststep = 0
gcalstep = 0
gpistep = 0

gteststate = {"TESTING", "TESTED"}
gmodestate = 0
gmodeoldstate = 0
gmodestatelist = {"AT", "CAL", "PI"}

testmachine_autocheck = 0 

function sminit() 	



rtn1 = scpi_cyl_excution("CONF:CYL1 UP")
if rtn1 == "UP" then

motion_home()
end



if rtn2 == "OPEN" then
gsmstep = 0

scpi_led_excution("CONF:LED OFF")
eth_write(0,gsmststate[1])
end
gsmsinitflag = 1
end

function smmain() 

gsmoldstep = gsmstep

if gsmstep == 0 then smstep0()
elseif gsmstep == 1 then smstep1()
elseif gsmstep == 2 then smstep2()
elseif gsmstep == 3 then smstep3()
elseif gsmstep == 4 then smstep4()
end


if gsmoldstep ~= gsmstep then
showstate()
end
end

function smstep0() 
delay(10)
rtn = allbtnispress(0.2) 										
if rtn == "Pressed" or gteststep == 1 or gcalstep == 2 then
gsmstep = 1												
scpi_led_excution("CONF:LED YELLOW")		
end

end

function smstep1()		
delay(10)
rtn = allbtnispress(0.2) 											
if rtn == "Pressed" or gteststep == 2 or gcalstep == 2 then
gsmstep = 2

ext_startok(500)
end

end

function smstep2() 	

rtn1 = scpi_servo_excution("CONF:SERVO CLOSE")
if rtn1 == "CLOSE" then

rtn2 = scpi_cyl_excution("CONF:CYL1 DOWN")

if rtn2 == "CYL ERROR" then
print("========CYL ERROR============")
errorexit()
end
end

if rtn1 == "CLOSE" and rtn2 == "DOWN" then
gsmstep = 3		
gteststep = 0
gcalstep = 0
end

end

function smstep3() 	
delay(10)
scpi_led_excution("CONF:LED GREEN")
gsmstep = 4	
end

function smstep4() 	
rtn = allbtnispress(0.3)  
if rtn == "Pressed" or gteststep == 3 or gcalstep == 3 then
rtn1 = scpi_cyl_excution("CONF:CYL1 UP") 		
if rtn1 == "UP" then
rtn2 = scpi_servo_excution("CONF:SERVO OPEN") 
if rtn2 == "OPEN" then
gsmstep = 0
gteststep = 0
gcalstep = 0
scpi_led_excution("CONF:LED OFF")
eth_write(0,"TESTED")		

ext_duttestresult(500)
end
end
end

end


function errorexit()
rtn1 = scpi_cyl_excution("CONF:CYL1 UP") 		
if rtn1 == "UP" then
rtn2 = scpi_servo_excution("CONF:SERVO OPEN") 
if rtn2 == "OPEN" then
gsmstep = 0
gteststep = 0
gcalstep = 0
scpi_led_excution("CONF:LED OFF")
eth_write(0,"ERROREXIT")		

dut_result = 2
ext_duttestresult(500)
end
end
end

function showstate()
if gsmstep == 0 then
eth_write(0,gsmststate[1])
print("STATE:",gsmststate[1])
elseif gsmstep == 1 then
eth_write(0,gsmststate[2])
print("STATE:",gsmststate[2])
elseif gsmstep == 2 then
eth_write(0,gsmststate[3])
print("STATE:",gsmststate[3])
elseif gsmstep == 3 then
eth_write(0,gsmststate[4])
print("STATE:",gsmststate[4])
elseif gsmstep == 5 then
eth_write(0,gsmststate[6])
print("STATE:",gsmststate[6])
end
end

//main.sc
sysopt(1, 0, -1)

ginitflag = 0
gnetinitedflag = 0
manualmode = 1


lock_flag= 0

axis = 1
axis_guide = 20 
axis_equivalent = 36000 

position_mode1 = 198.26 


axis_aim_pos = 198.26

axis_zero_pos = -60


axis_aim_vel = 200
axis_aim_acc = 400
axis_aim_dec = 400


scpi_test = 0
led_test = 0
cyl_test = 0
rf_test = 0
motion_test = 0


function task1_main()
print(" =TASK 2 START= ")
local netidx = 0	
local gprototype = 1			

eth_connect(netidx, gprototype)
print("=========================ginitFlag",ginitflag)

while ginitflag > 0 do
if net.netsts(netidx) > 0 then
delay(1)

read_data = eth_read(netidx)
if rtnisexist(read_data) then

delay(1)
scpi_recv = scpi_push(read_data)
end


if rtnisexist(scpi_recv) then
delay(1)
eth_write(netidx,scpi_recv)
end
else
eth_disconnect(netidx, gprototype)
end

end
end



function task2_main()
print(" =TASK 2 START= ")
while 1 > 0 do
if gsmsinitflag == 0 then
sminit()
end
delay(1)


btn_emerged()

ext_starttest(30)   	
ext_startreset(50) 	
ext_stoptest(50)	



gmodeoldstate = gmodestate

ext_modeselect(100)

if gmodeoldstate ~= gmodestate then
eth_write(0,gmodestatelist[gmodestate+1])
end

ext_starttest(50)   	
ext_startreset(50) 	
ext_stoptest(50)	

end
end


function task3_main()
while 1 > 0 do
if gsmsinitflag > 0 then
if manualmode == 0 then 
smmain()
else
delay(1)	
end
else
delay(1)
end

btn_emerged()

check_zero()

check_emerage()
end
end


function task4_main()
print(" =TASK 4 INIT= ")
delay(1000)
rtn = mc.axisop(axis,3) 
delay(1000)

servo_on = mc.axissts(axis,4)
if servo_on ~= 1 then
mc.axisop(axis,2)
end
gsmsinitflag = 0
manualmode = 0
end






//RF_Excution.sc

function jog_excution(param1)
if rf_test == 1 then
print(" =RF= ")
delay(3000)
switch1_encode(1)
switch1_encode(2)
switch1_encode(4)
end
end


function switch1_encode(index)
if index == 1 then
mc.setdo(1,0)
mc.setdo(2,0)
mc.setdo(3,0)
elseif index == 2 then
mc.setdo(1,1)
mc.setdo(2,0)
mc.setdo(3,0)
elseif index == 3 then
mc.setdo(1,0)
mc.setdo(2,1)
mc.setdo(3,0)
elseif index == 4 then
mc.setdo(1,1)
mc.setdo(2,1)
mc.setdo(3,0)
elseif index == 5 then
mc.setdo(1,0)
mc.setdo(2,0)
mc.setdo(3,1)
elseif index == 6 then
mc.setdo(1,1)
mc.setdo(2,0)
mc.setdo(3,1)
elseif index == 7 then
mc.setdo(1,0)
mc.setdo(2,1)
mc.setdo(3,1)
elseif index == 8 then
mc.setdo(1,1)
mc.setdo(2,1)
mc.setdo(3,1)
end
end


function switch2_encode(index)
if index == 1 then
mc.setdo(4,0)
mc.setdo(5,0)
mc.setdo(6,0)
elseif index == 2 then
mc.setdo(4,1)
mc.setdo(5,0)
mc.setdo(6,0)
elseif index == 3 then
mc.setdo(4,0)
mc.setdo(5,1)
mc.setdo(6,0)
elseif index == 4 then
mc.setdo(4,1)
mc.setdo(5,1)
mc.setdo(6,0)
elseif index == 5 then
mc.setdo(4,0)
mc.setdo(5,0)
mc.setdo(6,1)
elseif index == 6 then
mc.setdo(4,1)
mc.setdo(5,0)
mc.setdo(6,1)
elseif index == 7 then
mc.setdo(4,0)
mc.setdo(5,1)
mc.setdo(6,1)
elseif index == 8 then
mc.setdo(4,1)
mc.setdo(5,1)
mc.setdo(6,1)
end
end


function switch1_decode(param1)
one = mc.getdo(1)
two = mc.getdo(2)
three = mc.getdo(3)

index = one + two*2^1 +three * 2^2 + 1
return index
end


function switch2_decode(param1)
one = mc.getdo(4)
two = mc.getdo(5)
three = mc.getdo(6)

index = one + two*2^1 +three * 2^2 + 1
return index
end


//SCPI_Excution.sc

function scpi_excution(param1)
if scpi_test == 1 then
print(" =SCPI= ")
/*
rtn1 = scpi_push("CONFigure:LOCK ON")

rtn3 = scpi_push("READ:LED STATe?")
rtn4 = scpi_push("CONFigure:SWITCH2 RF2")
rtn5 = scpi_push("READ:SWITCH1:STATE?")
*/
scpi_push("CONFigure:SERVO CLOSE")
rtn = scpi_push("READ:SERVO:STATE?")
print(rtn)
scpi_push("CONFigure:SERVO OPEN")
rtn = scpi_push("READ:SERVO:STATE?")
print(rtn)
end
end


function scpi_push(str_scpi)

idxc = string.find(str_scpi,"CONF")
idxr = string.find(str_scpi,"READ")
idxt = string.find(str_scpi,"TRIG")
idxbase = string.find(str_scpi,"*")

if rtnisexist(idxc) then
return conf_push(str_scpi)
end


if rtnisexist(idxr) then
return read_push(str_scpi)
end



if rtnisexist(idxt) then
return trig_push(str_scpi)
end


if rtnisexist(idxbase) then
return base_push(str_scpi)
end

end

function base_push(str_scpi)
idxidn = string.find(str_scpi,"*IDN?")
if rtnisexist(idxidn) then
return "GTS PINPROBEG1 20240328 V0.0.1"
end
end


function conf_push(str_scpi)
idxlock = string.find(str_scpi,"LOCK")
idxled = string.find(str_scpi,"LED")
idxsw = string.find(str_scpi,"SWITCH")
idxcyl = string.find(str_scpi,"CYL")
idxservo = string.find(str_scpi,"SERV")
idxeth = string.find(str_scpi,"ETH")
idxtest = string.find(str_scpi,"TEST")
idxmode = string.find(str_scpi,"MODE")




if rtnisexist(idxlock) then
rtn = scpi_lock_excution(str_scpi)
return rtn
end


if rtnisexist(idxled) then
rtn = scpi_led_excution(str_scpi)
return rtn
end


if rtnisexist(idxsw) then
rtn = scpi_sw_excution(str_scpi)
return rtn
end


if rtnisexist(idxcyl) then
rtn = scpi_cyl_excution(str_scpi)
return rtn
end


if rtnisexist(idxservo) then
rtn = scpi_servo_excution(str_scpi)
return rtn
end


if rtnisexist(idxeth) then
rtn = scpi_eth_excution(str_scpi)
return rtn
end


if rtnisexist(idxtest) then
rtn = scpi_test_excution(str_scpi)
return rtn
end


if rtnisexist(idxmode) then
rtn = scpi_mode_excution(str_scpi)
return rtn
end


return "SCPI ERROR"
end

function read_push(str_scpi)
idxlock = string.find(str_scpi,"LOCK")
idxled = string.find(str_scpi,"LED")
idxsw = string.find(str_scpi,"SWITCH")
idxcyl = string.find(str_scpi,"CYL")
idxservo = string.find(str_scpi,"SERV")
idsys = string.find(str_scpi,"SYSTEM")
idtrig = string.find(str_scpi,"TRIG")
idxmode = string.find(str_scpi,"MODE")




if rtnisexist(idxlock) then
rtn = scpi_lock_excution(str_scpi)
return rtn
end


if rtnisexist(idxled) then
rtn = scpi_led_excution(str_scpi)
return rtn
end


if rtnisexist(idxsw) then
rtn = scpi_sw_excution(str_scpi)
return rtn
end


if rtnisexist(idxcyl) then
rtn = scpi_cyl_excution(str_scpi)
return rtn
end


if rtnisexist(idxservo) then
rtn = scpi_servo_excution(str_scpi)
return rtn
end


if rtnisexist(idsys) then
rtn = scpi_sys_excution(str_scpi)
return rtn
end


if rtnisexist(idxmode) then
rtn = scpi_mode_excution(str_scpi)
return rtn
end

end

function trig_push(str_scpi)
print("TRIG PUSH")
return 1
end

function scpi_lock_excution(str_scpi)

rtn_on = string.find(str_scpi,"LOCKED")
rtn_off = string.find(str_scpi,"UNLOCK")
rtn_state = string.find(str_scpi,"STAT")


if rtnisexist(rtn_on) then
lock_flag = 1
manualmode = 1
return "LOCKED"
end


if rtnisexist(rtn_off) then
lock_flag = 0
gsmsinitflag = 0
manualmode = 0
mc.setdo(2,0)

rtn_off = 0

motion_home()


return "UNLOCK"
end


if rtnisexist(rtn_state) then
if lock_flag ==1 then
return "LOCKED"
end
if lock_flag ==1 then
return "UNLOCK"
end
end
return "SCPI ERROR"
end


function scpi_led_excution(str_scpi)


rtn_red = string.find(str_scpi,"RED")
rtn_green = string.find(str_scpi,"GREEN")
rtn_yellow = string.find(str_scpi,"YELLOW")
rtn_off = string.find(str_scpi,"OFF")
rtn_state = string.find(str_scpi,"STAT")


if rtnisexist(rtn_off) then
rtn = led_encode(0)
return rtn
end

if rtnisexist(rtn_red) then
rtn = led_encode(1)
return rtn
end

if rtnisexist(rtn_green) then
rtn = led_encode(2)
return rtn
end

if rtnisexist(rtn_yellow) then
rtn = led_encode(3)
return rtn
end


if rtnisexist(rtn_state) then
rtn = led_decode()
return rtn;
end

return "SCPI ERROR"
end


