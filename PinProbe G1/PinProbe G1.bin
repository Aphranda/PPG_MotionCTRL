while count < countmax do
state = cyl1_decode()
if state == "UP" then
print("UP")
return "UP"
end
count = count + 1
print("CYL_UP:", count)
delay(100)
end
return "CYL ERROR"
end


if rtnisexist(rtn_down) then
rtn = cyl1_encode(1)
count = 0
countmax = 100
while count < countmax do
